{
  "name": "gg-pi-prototype",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "gg": "node --import tsx src/cli.ts",
    "test": "node --import tsx --test test/*.test.ts",
    "test:container": "node --import tsx --test test/container.integration.ts",
    "typecheck": "tsc --noEmit",
    "demo": "node --import tsx scripts/demo.ts",
    "build:worker": "podman build -t localhost/gg-pi-prototype -f Containerfile .",
    "format": "prettier --write src test scripts",
    "format:check": "prettier --check src test scripts",
    "evaluate:live": "node --import tsx scripts/evaluate-live.ts",
    "evaluate:images": "node --import tsx scripts/evaluate-images.ts"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "playwright": "1.63.0",
    "sharp": "^0.34.5",
    "typebox": "^1.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.0.0",
    "prettier": "^3.9.6",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  }
}
