{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gruenes Gewoelbe",
  "version": "0.1.0",
  "identifier": "dev.gruenesgewolbe.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "title": "Gruenes Gewoelbe",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self' asset: http://asset.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
